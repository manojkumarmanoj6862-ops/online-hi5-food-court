)
def admin_orders():

    if not session.get(
        "admin_logged_in"
    ):

        return jsonify({
            "success":False
        }),401


    try:

        orders_result = (
            supabase
            .table("orders")
            .select("*")
            .order(
                "id",
                desc=True
            )
            .execute()
        )


        orders =
            orders_result.data


        for order in orders:

            items_result = (
                supabase
                .table("order_items")
                .select("*")
                .eq(
                    "order_id",
                    order["id"]
                )
                .execute()
            )


            order["items"] =
                items_result.data


        return jsonify(
            orders
        )


    except Exception as error:

        print(error)

        return jsonify({
            "success":False
        }),500


