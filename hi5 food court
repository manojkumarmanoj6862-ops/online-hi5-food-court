async function updateStatus(
    id,
    status
){

    const response =
        await fetch(
            "/api/admin/orders/" +
            id,
            {

                method:"PUT",

                headers:{
                    "Content-Type":
                    "application/json"
                },

                body:
                JSON.stringify({
                    status:status
