@app.route(
    "/api/admin/orders/<int:order_id>",
    methods=["PUT"]
)
def update_order_status(
    order_id
):

    if not session.get(
        "admin_logged_in"
    ):

        return jsonify({
            "success":False,
            "message":
            "Unauthorized"
        }),401


    try:

        data =
            request.get_json()


        status =
            data.get(
                "status"
            )


        allowed = [

            "Pending",
            "Accepted",
            "Preparing",
            "Ready",
            "Completed",
            "Rejected"

        ]


        if status not in allowed:

            return jsonify({

                "success":False,

                "message":
                "Invalid status"

            }),400


        supabase \
            .table("orders") \
            .update({
                "status":status
            }) \
            .eq(
                "id",
                order_id
            ) \
            .execute()


        return jsonify({

            "success":True

        })


    except Exception as error:

        print(error)

        return jsonify({

            "success":False

        }),500


