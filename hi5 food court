# CREATE ORDER
# ==========================================================

@app.route(
    "/api/orders",
    methods=["POST"]
)
def create_order():

    try:

        data =
            request.get_json()


        customer_name =
            data.get(
                "customer_name"
            )

        phone =
            data.get(
                "phone"
            )

        order_type =
            data.get(
                "order_type"
            )

        address =
            data.get(
                "address"
            )

        items =
            data.get(
                "items",
                []
            )


        if not customer_name:
            return jsonify({
                "success":False,
                "message":
                "Name required"
            }),400


        if not phone:
            return jsonify({
                "success":False,
                "message":
                "Phone required"
            }),400


        if not items:

            return jsonify({
                "success":False,
                "message":
                "Cart is empty"
            }),400


        # -----------------------------------
        # VERIFY PRICES FROM DATABASE
        # -----------------------------------

        menu_ids = [
            item["id"]
            for item in items
        ]


        menu_result = (
            supabase
            .table("menu")
            .select("id,name,price")
            .in_("id", menu_ids)
            .eq("available", True)
            .execute()
        )


        menu_map = {

            int(item["id"]):
            item

            for item
            in menu_result.data

        }


        verified_items = []

        total = 0


        for item in items:

            item_id =
                int(item["id"])

            quantity =
                int(item["quantity"])


            if item_id not in menu_map:

                return jsonify({
                    "success":False,
                    "message":
                    "Invalid menu item"
                }),400


            if quantity < 1:

                return jsonify({
                    "success":False,
                    "message":
                    "Invalid quantity"
                }),400


            db_item =
                menu_map[item_id]


            price =
                float(
                    db_item["price"]
                )


            total += (
                price *
                quantity
            )


            verified_items.append({

                "menu_id":
                    item_id,

                "item_name":
                    db_item["name"],

                "quantity":
                    quantity,

                "price":
                    price

            })


        # -----------------------------------
        # CREATE ORDER
        # -----------------------------------

        order_result = (
            supabase
            .table("orders")
            .insert({

                "customer_name":
                    customer_name,

                "phone":
                    phone,

                "order_type":
                    order_type,

                "address":
                    address,

                "total":
                    total,

                "status":
                    "Pending"

            })
            .execute()
        )


        order =
            order_result.data[0]


        order_id =
            order["id"]


        # -----------------------------------
        # CREATE ORDER ITEMS
        # -----------------------------------

        rows = []


        for item in verified_items:

            rows.append({

                "order_id":
                    order_id,

                "menu_id":
                    item["menu_id"],

                "item_name":
                    item["item_name"],

                "quantity":
                    item["quantity"],

                "price":
                    item["price"]

            })


        supabase \
            .table("order_items") \
            .insert(rows) \
            .execute()


        return jsonify({

            "success":True,

            "order_id":
                order_id,

            "total":
                total

        })


    except Exception as error:

        print(
            "ORDER ERROR:",
            error
        )

        return jsonify({

            "success":False,

            "message":
            "Unable to place order"

        }),500


